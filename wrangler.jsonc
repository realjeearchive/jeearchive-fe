{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "jeearchive-frontend",

  "main": ".open-next/worker.js",

  "compatibility_date": "2025-06-15",

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}